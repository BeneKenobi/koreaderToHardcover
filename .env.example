# Hardcover API Token
HARDCOVER_BEARER_TOKEN=your_token_here

# WebDAV Settings (KOReader Sync)
# Base WebDAV URL; the database is fetched from WEBDAV_URL/WEBDAV_PATH/KOREADER_DB_PATH
WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/user/
WEBDAV_USERNAME=your_webdav_user
WEBDAV_PASSWORD=your_webdav_password

# Web Dashboard Settings
APP_USERNAME=admin
APP_PASSWORD=admin
SYNC_INTERVAL_MINUTES=60

# Optional/Advanced Settings
# Folder of the KOReader DB, relative to WEBDAV_URL
WEBDAV_PATH=/KOReader
# Filename for KOReader DB (default: statistics.sqlite3)
KOREADER_DB_PATH=statistics.sqlite3
# Log file path for web dashboard
LOG_PATH=app.log
# DuckDB database file path
DB_PATH=reading_stats.duckdb
# Secret key for session cookies (web dashboard).
# If unset, one is generated and stored next to the database.
SECRET_KEY=
